FROM mcr.microsoft.com/devcontainers/base:trixie

# mise のインストール
ENV MISE_DATA_DIR="/mise"
ENV MISE_GLOBAL_CONFIG_FILE="/mise/config.toml"
ENV PATH="/mise/shims:$PATH"
ENV MISE_INSTALL_PATH="/usr/local/bin/mise"
RUN curl https://mise.run | sh

# 全ユーザーが shim 経由でバージョン解決できるよう、mise のグローバル設定にツールを登録する。
# node は mise の npm バックエンドの動作に必要。また npm_args で claude-code の
# postinstall スクリプト（ネイティブバイナリのダウンロード）を許可している。
RUN mkdir -p /mise && printf '%s\n' \
  '[tools]' \
  'node = "lts"' \
  '"npm:@anthropic-ai/claude-code" = { version = "latest", npm_args = "--ignore-scripts=false" }' \
  '"github:anomalyco/opencode" = "latest"' \
  '"npm:@openai/codex" = "latest"' \
  > /mise/config.toml

RUN mise install --minimum-release-age "7d"
