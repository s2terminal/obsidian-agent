# APIキー
GEMINI_API_KEY=SUPER_SECRET_KEY_REPLACE_ME

# アプリ設定
# feed.mdとstatus.yamlを置くディレクトリ（OBSIDIAN_ROOTからの相対パス）
OBSIDIAN_ROOT=/path/to/obsidian/Vault
OBSIDIAN_AGENT_DIR=obsidian_agent
SLACK_WEBHOOK_URL=https://example.com/your/slack/webhook/url
TIMEZONE=Asia/Tokyo

# Langfuse (オプション: LLMトレーシング)
# https://cloud.langfuse.com でプロジェクトを作成し、APIキーを取得してください
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_HOST=https://cloud.langfuse.com

# Raindrop を使う場合のみ設定（個人用 Test token）
RAINDROP_ACCESS_TOKEN=REPLACE_ME
